# ---- NSD.SG environment ----------------------------------------------------
# Copy to .env (never commit .env). All values are read once at boot.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public apex domain. Tenant sites live on *.BASE_DOMAIN
BASE_DOMAIN=nsd.sg
# Where the platform UI is served (apex + www). Comma-separated.
PLATFORM_HOSTS=nsd.sg,www.nsd.sg
# Scheme used in generated links
PUBLIC_SCHEME=https

# Persistent data directory (database, uploads, releases, logs)
DATA_DIR=/var/lib/nsd

# 64+ random hex chars. Generate: openssl rand -hex 48
SESSION_SECRET=change-me-openssl-rand-hex-48

# First admin account. Created on first boot if no admin exists.
ADMIN_EMAIL=admin@nsd.sg
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=NSD Admin

# Trust X-Forwarded-* from this proxy (Caddy on the same host)
TRUST_PROXY=127.0.0.1

# Upload limits (bytes). Plan limits are applied on top of these hard caps.
MAX_UPLOAD_BYTES=104857600
MAX_ZIP_ENTRIES=5000
MAX_ZIP_UNCOMPRESSED_BYTES=268435456

# Branding text and link injected into every hosted page (unless plan removes it)
BRANDING_TEXT=Powered by NasarDigital · nsd.sg
BRANDING_URL=https://nsd.sg
BRANDING_PARTNER_URL=https://nasardigital.com

# Optional SMTP for verification / reset emails. Leave blank to log emails to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NSD.SG <no-reply@nsd.sg>

# Caddy on-demand TLS ask endpoint shared secret (optional hardening)
TLS_ASK_TOKEN=
