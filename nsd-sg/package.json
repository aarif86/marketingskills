{
  "name": "nsd-sg",
  "version": "0.5.4",
  "description": "NSD.SG — upload your AI-generated website, host it on name.nsd.sg",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "main": "server.cjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "migrate": "node src/cli.js migrate",
    "cli": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && for f in $(find src -name '*.js'); do node --check $f || exit 1; done"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.1",
    "yauzl": "^3.2.0"
  },
  "license": "UNLICENSED"
}
