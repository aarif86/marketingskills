# ---- NSD.SG on Hostinger managed hosting (Cloud Startup, account u162210766) -----------------------
# Shipped inside the build archive as `.env`. NO SECRETS HERE. Secrets go in DATA_DIR/.env on the server
# (hPanel > Files > File manager) or in hPanel's Node.js environment variables; real env vars always win.

NODE_ENV=production
PORT=3000

BASE_DOMAIN=nsd.sg
# nsd.sg, www + Hostinger's preview hostname (it probes the app after every deploy)
PLATFORM_HOSTS=nsd.sg,www.nsd.sg,grey-lobster-115902.hostingersite.com
PUBLIC_SCHEME=https

# Persistent data (SQLite, releases, temp uploads). Outside every document root; survives deploys.
DATA_DIR=/home/u162210766/domains/nsd.sg/nsd-data

# Tenants are served by LiteSpeed from here; each <name> is a Hostinger subdomain with this docroot.
TENANT_ROOT=/home/u162210766/domains/nsd.sg/public_html/tenants
PUBLIC_HTML=/home/u162210766/domains/nsd.sg/public_html
HOSTINGER_USERNAME=u162210766
# HOSTINGER_API_TOKEN=   <- set in DATA_DIR/.env (hPanel > API tokens), never here

# LiteSpeed proxies to the app over a Unix socket from 127.0.0.1
TRUST_PROXY=127.0.0.1

# First admin. Password is generated on first boot into DATA_DIR/initial-admin-password.txt unless
# ADMIN_PASSWORD is set in DATA_DIR/.env.
ADMIN_EMAIL=aarif.raziff@gmail.com
ADMIN_NAME=Aarif

MAX_UPLOAD_BYTES=104857600
MAX_ZIP_ENTRIES=5000
MAX_ZIP_UNCOMPRESSED_BYTES=268435456

BRANDING_TEXT=Powered by NasarDigital · nsd.sg
BRANDING_URL=https://nsd.sg
BRANDING_PARTNER_URL=https://nasardigital.com

# SMTP_* also belong in DATA_DIR/.env
SMTP_FROM=NSD.SG <no-reply@nsd.sg>
